{
  "name": "pennyworth-desktop",
  "version": "0.1.0",
  "description": "Pennyworth: Linux-first agentic desktop assistant",
  "main": "src/main.js",
  "private": true,
  "author": "Pennyworth Team",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --no-sandbox --ozone-platform-hint=auto",
    "crawl:docs": "node scripts/crawl-docs.js",
    "init:config": "node scripts/init-config.js",
    "json:normalize": "node scripts/normalize-json.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "test:electron": "electron scripts/electron-smoke.js",
    "test": "node --test src/tests/*.test.js"
  },
  "dependencies": {
    "axios": "^1.9.0",
    "cheerio": "^1.0.0",
    "dotenv": "^16.5.0",
    "electron-store": "^10.1.0",
    "screenshot-desktop": "^1.15.2",
    "@huggingface/transformers": "^4.2.0"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.pennyworth.desktop",
    "productName": "Pennyworth",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "public/**/*",
      "config/**/*",
      "data/**/*",
      "package.json",
      ".env.example",
      "README.md"
    ],
    "win": {
      "icon": "public/pennyworth.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities"
    },
    "linux": {
      "icon": "public/pennyworth.png",
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Utility"
    }
  },
  "overrides": {
    "sharp": "^0.35.0",
    "adm-zip": "^0.6.0"
  }
}
